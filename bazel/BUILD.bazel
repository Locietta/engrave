load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

exports_files(
    glob(["*"]) + ["pch/engraving_pch.h"],
)

config_setting(
    name = "opt_mode",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows_msvc",
    constraint_values = [
        "@platforms//os:windows",
        "@xclang//platforms/libc:msvc",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "opt_msvc",
    constraint_values = [
        "@platforms//os:windows",
        "@xclang//platforms/libc:msvc",
    ],
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "opt_msvc_gc",
    constraint_values = [
        "@platforms//os:windows",
        "@xclang//platforms/libc:msvc",
    ],
    values = {
        "compilation_mode": "opt",
        "features": "gc_sections",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "opt_linux_gc",
    constraint_values = ["@platforms//os:linux"],
    values = {
        "compilation_mode": "opt",
        "features": "gc_sections",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "asan_msvc",
    constraint_values = [
        "@platforms//os:windows",
        "@xclang//platforms/libc:msvc",
    ],
    values = {"features": "asan"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "ubsan_msvc",
    constraint_values = [
        "@platforms//os:windows",
        "@xclang//platforms/libc:msvc",
    ],
    values = {"features": "ubsan"},
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "pch",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "pch_enabled",
    flag_values = {":pch": "true"},
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "playback_harness",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "playback_harness_enabled",
    flag_values = {":playback_harness": "true"},
    visibility = ["//visibility:public"],
)
