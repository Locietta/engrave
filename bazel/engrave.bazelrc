common --enable_platform_specific_config
common --registry=https://raw.githubusercontent.com/engrave-music/bazel-registry/main
common --registry=https://bcr.bazel.build/
common --experimental_repository_downloader_retries=10 --http_timeout_scaling=2
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --cxxopt=-std=c++23 --host_cxxopt=-std=c++23
build --incompatible_strict_action_env
build --experimental_disk_cache_gc_max_size=20G
build --@harfbuzz//:freetype=//:freetype

build -c opt
build:windows --platforms=@xclang//platforms:x86_64-pc-windows-msvc
# xclang's GNU driver targeting MSVC links the multithreaded hybrid CRT without
# predefining _MT, which causes GTest/CRT headers to assume single-threaded builds.
build:windows --copt=-D_MT
build:release -c opt --features=gc_sections
build:dist --config=release --copt=-flto=thin --linkopt=-flto=thin --features=thinlto_cache
build:releasedbg -c opt --copt=-g
build:debug -c dbg
build:asan -c fastbuild --strip=never --copt=-O1 --copt=-gline-tables-only --features=asan --features=ubsan
# ThreadSanitizer for parallel synthesis, async encoding, background audio, and
# multi-page PNG verification. xclang ships TSan runtimes for glibc Linux and
# macOS only; its Windows targets reject --features=tsan.
build:tsan -c fastbuild --strip=never --copt=-O1 --copt=-gline-tables-only --features=tsan
