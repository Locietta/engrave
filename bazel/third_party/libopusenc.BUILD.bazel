load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "opusenc_private_hdrs",
    hdrs = [
        "config_include/config.h",
    ] + glob(["src/*.h"]),
    includes = [
        "config_include",
        "src",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libopusenc",
    srcs = [
        "src/ogg_packer.c",
        "src/opus_header.c",
        "src/opusenc.c",
        "src/picture.c",
        "src/resample.c",
        "src/unicode_support.c",
    ],
    hdrs = [
        "include/opusenc.h",
        "staged_include/opus/opusenc.h",
    ],
    copts = ["-w"],
    defines = [
        "OUTSIDE_SPEEX",
        "RANDOM_PREFIX=opusenc_prefix",
    ],
    implementation_deps = [":opusenc_private_hdrs"],
    includes = [
        "include",
        "staged_include",
    ],
    local_defines = ["HAVE_CONFIG_H"],
    visibility = ["//visibility:public"],
    deps = ["@libopus"],
)
