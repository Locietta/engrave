load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "gtest_private_hdrs",
    hdrs = glob(
        [
            "googletest/src/*.h",
            "googlemock/src/*.h",
        ],
        allow_empty = True,
    ),
    includes = [
        "googlemock",
        "googletest",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "gtest",
    srcs = [
        "googlemock/src/gmock-all.cc",
        "googletest/src/gtest-all.cc",
    ],
    hdrs = glob([
        "googlemock/include/**/*.h",
        "googletest/include/**/*.h",
    ]),
    copts = ["-w"],
    implementation_deps = [":gtest_private_hdrs"],
    includes = [
        "googlemock/include",
        "googletest/include",
    ],
    textual_hdrs = glob(
        [
            "googlemock/src/*.cc",
            "googletest/src/*.cc",
        ],
        exclude = [
            "googlemock/src/gmock-all.cc",
            "googlemock/src/gmock_main.cc",
            "googletest/src/gtest-all.cc",
            "googletest/src/gtest_main.cc",
        ],
    ),
    visibility = ["//visibility:public"],
)
