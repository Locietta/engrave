module(
    name = "engrave",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "xclang", version = "23.1.5.2")

bazel_dep(name = "amc", version = "2.8.1")
bazel_dep(name = "dyn", version = "0.1.1")
bazel_dep(name = "glaze", version = "9.1.0")
bazel_dep(name = "gtest", version = "1.17.0")
bazel_dep(name = "gtl", version = "1.3.1")
bazel_dep(name = "harfbuzz", version = "12.3.0")
bazel_dep(name = "lame", version = "3.100")
bazel_dep(name = "libflac", version = "1.4.3")
bazel_dep(name = "libopus", version = "1.5.2")
bazel_dep(name = "libopusenc", version = "0.2.1")
bazel_dep(name = "pugixml", version = "1.15.bcr.1")
bazel_dep(name = "unordered_dense", version = "5.3.3")
bazel_dep(name = "utfcpp", version = "4.1.1")

xclang = use_extension("@xclang//bazel:extensions.bzl", "xclang")
xclang.windows_sdk(accept_license = True)

engrave_deps = use_extension("//bazel:deps.bzl", "engrave_deps")
use_repo(
    engrave_deps,
    "engrave_config",
    "pixi_deps",
)
